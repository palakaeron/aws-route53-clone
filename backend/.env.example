# Persistent SQLite database. Set this to the mounted persistent volume path in production.
DATABASE_URL=sqlite:////var/lib/route53/route53.db

# Comma-separated browser origins. Never use * with credentialed cookies.
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001

# Session lifetime in hours. SESSION_EXPIRY is also accepted.
SESSION_TTL_HOURS=8

# Set true when the backend is served over HTTPS.
SESSION_COOKIE_SECURE=false
